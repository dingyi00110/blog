CMS_HOST=127.0.0.1
CMS_PORT=3001
CMS_SITE_ORIGIN=https://39.102.210.194
CMS_REPO_DIR=/usr/local/dlq/blog
CMS_RELEASE_ROOT=/var/www/neverdown
CMS_SESSION_HOURS=24
CMS_GIT_PUSH=false
CMS_GIT_REMOTE=origin
CMS_GIT_BRANCH=main

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=neverdown_cms
MYSQL_USER=neverdown_cms
MYSQL_PASSWORD=replace_with_a_strong_password

# Leave AI_CHAT_PROVIDER empty to keep the public assistant disabled.
AI_CHAT_PROVIDER=openai
AI_EMBEDDING_PROVIDER=openai
AI_TIMEOUT_MILLISECONDS=45000

# OpenAI
OPENAI_API_KEY=replace_with_an_openai_api_key
OPENAI_CHAT_MODEL=gpt-5.6-terra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Qwen / DashScope (set providers to qwen to use these values)
DASHSCOPE_API_KEY=replace_with_a_dashscope_api_key
QWEN_CHAT_MODEL=qwen-plus
QWEN_EMBEDDING_MODEL=text-embedding-v3
