{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NeverCull",
  "version": "0.1.0",
  "identifier": "art.neverdown.nevercull",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "NeverCull", "width": 1440, "height": 900, "minWidth": 960, "minHeight": 640 }],
    "security": { "assetProtocol": { "enable": true, "scope": ["**"] }, "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost" } },
  "bundle": { "active": true, "targets": "all", "icon": [] }
}
