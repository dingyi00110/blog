<% const lang = ui_lang(); %>
<section class="hero">
  <div class="hero-copy">
    <p class="eyebrow"><span class="status-dot"></span><%= __('system_online') %> · <%= new Date().getFullYear() %></p>
    <h1><span><%= __('hero_build') %></span><span class="hero-accent"><%= __('hero_remember') %></span></h1>
    <p class="hero-deck"><%= lang === 'en' ? config.subtitle : config.description %></p>
    <div class="hero-actions"><a class="button primary" href="#latest"><%= __('explore_stories') %> ↓</a><button class="button ai-open" type="button"><%= __('ask_ai') %> ✦</button></div>
  </div>
  <aside class="hero-signal" aria-label="<%= __('editorial_signal') %>">
    <div class="signal-orbit"><span></span><i></i></div>
    <p>NEVERDOWN<br>EDITORIAL<br>SIGNAL</p>
    <small><%= __('signal_caption') %></small>
  </aside>
</section>
<section class="ai-prompt-band">
  <div><span class="kicker">AI / KNOWLEDGE</span><h2><%= __('ask_archive') %></h2></div>
  <button class="ai-prompt ai-open" type="button"><span><%= __('ai_prompt_example') %></span><b>↗</b></button>
</section>
<section class="topic-strip" aria-label="<%= __('topics') %>">
  <span class="kicker">TOPICS / INDEX</span>
  <div>
    <% site.tags.toArray().slice(0, 6).forEach((tag, index) => { %>
      <a href="<%= url_for(tag.path) %>"><small><%= String(index + 1).padStart(2, '0') %></small><%= tag.name %></a>
    <% }) %>
  </div>
</section>
<section class="post-list" id="latest">
  <div class="section-heading"><div><span class="kicker">01 / <%= __('latest_issue') %></span><h2><%= __('latest_stories') %></h2></div><span><%= page.total || page.posts.length %> <%= __('articles') %></span></div>
  <div class="editorial-grid"><% page.posts.each((post, index) => { %><%- partial('_partial/post-card', { post, index }) %><% }) %></div>
  <% if (!page.posts.length) { %><p class="empty"><%= __('empty') %></p><% } %>
</section>
<% if (page.total > 1) { %><nav class="pagination"><%- paginator({prev_text: '←', next_text: '→'}) %></nav><% } %>
