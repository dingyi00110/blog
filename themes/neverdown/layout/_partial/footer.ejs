<footer class="site-footer">
  <div class="shell footer-inner">
    <div><a class="brand" href="<%= url_for('/') %>"><span class="brand-mark">N/</span><%= config.title %></a><p><%= __('footer_manifesto') %></p></div>
    <div class="footer-links"><a href="<%= url_for('/archives/') %>"><%= __('archives') %></a><a href="<%= url_for('/authors/') %>"><%= __('authors') %></a><a href="<%= url_for('/atom.xml') %>">RSS</a></div>
    <div class="footer-meta"><span><span class="status-dot"></span><%= __('system_online') %></span><span>© <%= theme.footer.since %>–<%= new Date().getFullYear() %></span></div>
  </div>
</footer>
<div class="search-modal" role="dialog" aria-modal="true" aria-label="<%= __('search') %>" hidden>
  <div class="search-panel">
    <button class="search-close" type="button" aria-label="Close">×</button>
    <label class="search-label" for="site-search"><span class="prompt">$</span> <%= __('search') %></label>
    <input id="site-search" type="search" placeholder="<%= __('search_placeholder') %>" autocomplete="off">
    <div class="search-results" aria-live="polite"></div>
  </div>
</div>
<aside class="ai-drawer" aria-hidden="true" aria-label="<%= __('ai_assistant') %>">
  <div class="ai-drawer-head"><div><span class="status-dot"></span><strong>NeverDown AI</strong><small><%= __('grounded_in_archive') %></small></div><button class="ai-close" type="button" aria-label="<%= __('close') %>">×</button></div>
  <div class="ai-messages" aria-live="polite"><div class="ai-welcome"><span>✦</span><h2><%= __('ai_welcome_title') %></h2><p><%= __('ai_welcome_body') %></p><div class="ai-suggestions"><button type="button"><%= __('ai_suggestion_one') %></button><button type="button"><%= __('ai_suggestion_two') %></button></div></div></div>
  <form class="ai-form"><label class="sr-only" for="ai-question"><%= __('ask_ai') %></label><textarea id="ai-question" maxlength="2000" rows="2" placeholder="<%= __('ai_placeholder') %>"></textarea><div><small><%= __('ai_disclaimer') %></small><button type="submit" aria-label="<%= __('send') %>">↑</button></div></form>
</aside>
<div class="ai-backdrop" hidden></div>
<script src="<%= url_for('/js/main.js') %>" defer></script>
<% if (theme.analytics.umami_url && theme.analytics.website_id) { %>
  <script defer src="<%= theme.analytics.umami_url %>/script.js" data-website-id="<%= theme.analytics.website_id %>"></script>
<% } %>
</body>
</html>
